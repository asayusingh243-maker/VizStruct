# Copy this file to ".env" and fill in your own values

PORT=5000

# Any random long string works. Used to sign login tokens (JWT).
JWT_SECRET=change_this_to_a_long_random_secret

# Allow the frontend (Next.js) to call this backend
CLIENT_URL=http://localhost:3000

# Python ML service used for learner clustering predictions
ML_SERVICE_URL=http://127.0.0.1:8000
